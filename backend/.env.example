PORT="7070"
POSTGRES_DSN="postgres://postgres:password@localhost:5432/datti?sslmode=disable"

# CORS (カンマ区切りの許可オリジン。未指定なら http://localhost:3000)
CORS_ALLOW_ORIGINS="http://localhost:3000"

# LINE Login
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""

# アバター画像ストレージ (本番: Cloudflare R2 / ローカル: LocalStack S3)
# R2 は S3 互換 API なので aws-sdk-go-v2 がそのまま使える
S3_AVATAR_BUCKET="local-datti-cdn"
AVATAR_BASE_URL="http://localhost:4566/local-datti-cdn"
# S3 API エンドポイント (本番では https://{account_id}.r2.cloudflarestorage.com)
AWS_ENDPOINT_URL_S3="http://localhost:4566"
# R2 専用 credentials (Cloudflare で発行)。未指定なら AWS_ACCESS_KEY_ID/* を流用 (LocalStack 用)
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# OpenTelemetry
OTEL_SERVICE_NAME="Datti API"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_OTLP_TRACES_INSECURE=true
