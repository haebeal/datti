PORT="7070"
POSTGRES_DSN="postgres://postgres:password@localhost:5432/datti?sslmode=disable"

# LINE Login
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""

# S3 (アバター画像)
S3_AVATAR_BUCKET="local-datti-avatar"
AVATAR_BASE_URL="http://localhost:4566/local-datti-avatar"
# LocalStack を使う場合のみ (S3 専用。Cognito は実 AWS を使うので AWS_ENDPOINT_URL は設定しないこと)
AWS_ENDPOINT_URL_S3="http://localhost:4566"

# OpenTelemetry
OTEL_SERVICE_NAME="Datti API"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_OTLP_TRACES_INSECURE=true
